# Copy to .env for local development. On Render, set these as environment
# variables instead (never commit real values).

# Signs organiser sign-ins and anti-spam tokens. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Password for the organiser view at /organiser (at least 12 characters).
ORGANISER_PASSWORD=

# Store sign-ups in a hosted Turso database (needed on Render's free plan).
# You can reuse the Shared Light Café database: this site uses its own table.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Without Turso, sign-ups go in a local SQLite file in this folder.
DATA_DIR=./data

NODE_ENV=development
TRUST_PROXY=
PORT=3000
